# ============================================
# GIMBIE ADVENTIST GENERAL HOSPITAL
# ENVIRONMENT VARIABLES
# ============================================

# Server Configuration
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Frontend URLs
FRONTEND_URL=https://ghimbi-adventist-general-hospital.vercel.app
FRONTEND_DEV_URL=http://localhost:3000

# Database - MongoDB
MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/gimbie-hospital?retryWrites=true&w=majority
MONGODB_DATABASE=gimbie-hospital

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-this

# CORS
CORS_ORIGIN=https://ghimbi-adventist-general-hospital.vercel.app

# Email Configuration (Gmail/SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@gimbiehospital.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Gateway (Stripe/Chapa)
STRIPE_SECRET_KEY=sk_test_xxxxx
CHAPA_SECRET_KEY=chapa-test-key

# QR Code Settings
QR_APP_URL=https://ghimbi-adventist-general-hospital.vercel.app

# Upload Limits
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Backup Settings
BACKUP_PATH=./backups
BACKUP_SCHEDULE=0 0 2 * * *

# Logging
LOG_LEVEL=info
LOG_PATH=./logs

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# AI Features
AI_API_KEY=your-ai-api-key
AI_API_URL=https://api.openai.com/v1

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Hospital Settings
HOSPITAL_NAME=Gimbie Adventist General Hospital
HOSPITAL_PHONE=+251-XX-XXX-XXXX
HOSPITAL_EMAIL=info@gimbiehospital.com
HOSPITAL_ADDRESS=Gimbie, Ethiopia
HOSPITAL_LATITUDE=9.1234
HOSPITAL_LONGITUDE=35.5678

# Emergency Contacts
EMERGENCY_PHONE=911
AMBULANCE_PHONE=+251-XX-XXX-XXXX

# Language Settings
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,om,am

# Development
DEBUG=false
